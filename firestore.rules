rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function getConversation(conversationId) {
      return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
    }

    function isConversationParticipant(conversationId) {
      return isAuthenticated() &&
        request.auth.uid in getConversation(conversationId).participants;
    }

    function isValidDeterministicId(participants, conversationId) {
      return participants is list &&
        participants.size() == 2 &&
        participants[0] is string &&
        participants[1] is string &&
        participants[0] != participants[1] &&
        ((participants[0] < participants[1] && conversationId == participants[0] + '_' + participants[1]) ||
         (participants[1] < participants[0] && conversationId == participants[1] + '_' + participants[0]));
    }

    // =========================================================================
    // USERS COLLECTION
    // =========================================================================
    match /users/{userId} {
      // Authenticated users can read registered user profiles (for phone number matching)
      allow read: if isAuthenticated();

      // Users can only create and modify their own user profile document
      allow create, update: if isUser(userId);
      allow delete: if false;

      // User devices / FCM push tokens subcollection
      // Strictly private to the user themselves (no cross-user token reading or injection)
      match /devices/{deviceId} {
        allow read, write: if isUser(userId);
      }
    }

    // =========================================================================
    // CONVERSATIONS COLLECTION (/conversations/{conversationId})
    // =========================================================================
    match /conversations/{conversationId} {
      // 1. Participant-only read access
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;

      // 2. Strict conversation creation validation:
      // - Authenticated creator must be in the participants array
      // - Exactly 2 unique participants
      // - Canonical conversation ID format enforced: min(uidA, uidB) + '_' + max(uidA, uidB)
      // - Schema strictly constrained to known metadata fields (no arbitrary payload injection)
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly(['id', 'participants', 'createdAt', 'updatedAt', 'keyVersion']) &&
        request.resource.data.id == conversationId &&
        request.auth.uid in request.resource.data.participants &&
        isValidDeterministicId(request.resource.data.participants, conversationId) &&
        request.resource.data.createdAt is int &&
        request.resource.data.updatedAt is int &&
        request.resource.data.keyVersion is int;

      // 3. Participant immutability on updates:
      // - Only existing conversation participants can update (e.g. updating timestamp)
      // - Participants array and conversationId are completely immutable
      // - Creation timestamp and keyVersion are immutable
      allow update: if isAuthenticated() &&
        request.auth.uid in resource.data.participants &&
        request.resource.data.keys().hasOnly(['id', 'participants', 'createdAt', 'updatedAt', 'keyVersion']) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.participants == resource.data.participants &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.keyVersion == resource.data.keyVersion &&
        request.resource.data.updatedAt is int;

      // 4. Conversations cannot be deleted directly by clients
      allow delete: if false;

      // =======================================================================
      // MESSAGES SUBCOLLECTION (/conversations/{conversationId}/messages/{messageId})
      // =======================================================================
      match /messages/{messageId} {
        // 1. Participant-only message read access
        allow read: if isConversationParticipant(conversationId);

        // 2. Encrypted message creation validation:
        // - Authenticated senderId anti-spoofing check
        // - Sender must be a participant of parent conversation
        // - Recipient must be the second participant in the parent conversation
        // - Recipient != Sender
        // - conversationId in payload matches parent route ID
        // - document ID matches payload 'id'
        // - Ciphertext and IV must be non-empty strings
        // - Plaintext fields ('decryptedText', 'text', 'plaintext') are strictly forbidden
        // - Message type and status validated against allowed enums
        allow create: if isAuthenticated() &&
          request.resource.data.keys().hasOnly(['id', 'conversationId', 'senderId', 'recipientId', 'ciphertext', 'iv', 'type', 'timestamp', 'keyVersion', 'status', 'mediaUrl', 'replyToId', 'replyToText', 'replyToSender', 'audioDurationSec']) &&
          request.resource.data.id == messageId &&
          request.resource.data.conversationId == conversationId &&
          request.auth.uid == request.resource.data.senderId &&
          isConversationParticipant(conversationId) &&
          request.resource.data.recipientId in getConversation(conversationId).participants &&
          request.resource.data.recipientId != request.resource.data.senderId &&
          request.resource.data.ciphertext is string &&
          request.resource.data.ciphertext.size() > 0 &&
          request.resource.data.iv is string &&
          request.resource.data.iv.size() > 0 &&
          request.resource.data.type in ['text', 'image', 'audio', 'file'] &&
          request.resource.data.timestamp is int &&
          request.resource.data.keyVersion is int &&
          request.resource.data.status in ['sending', 'sent', 'delivered', 'read', 'failed'] &&
          !('decryptedText' in request.resource.data) &&
          !('text' in request.resource.data) &&
          !('plaintext' in request.resource.data);

        // 3. Message update validation (Envelope Immutability):
        // - Only participants can update (e.g. status updates)
        // - Ciphertext, IV, senderId, recipientId, conversationId, id, and timestamp are completely immutable
        allow update: if isConversationParticipant(conversationId) &&
          request.resource.data.keys().hasOnly(['id', 'conversationId', 'senderId', 'recipientId', 'ciphertext', 'iv', 'type', 'timestamp', 'keyVersion', 'status', 'mediaUrl', 'replyToId', 'replyToText', 'replyToSender', 'audioDurationSec']) &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.conversationId == resource.data.conversationId &&
          request.resource.data.senderId == resource.data.senderId &&
          request.resource.data.recipientId == resource.data.recipientId &&
          request.resource.data.ciphertext == resource.data.ciphertext &&
          request.resource.data.iv == resource.data.iv &&
          request.resource.data.type == resource.data.type &&
          request.resource.data.timestamp == resource.data.timestamp &&
          request.resource.data.keyVersion == resource.data.keyVersion &&
          request.resource.data.status in ['sending', 'sent', 'delivered', 'read', 'failed'];

        // 4. Message deletion:
        // - Only the original authenticated sender may delete their message
        allow delete: if isAuthenticated() && request.auth.uid == resource.data.senderId;
      }
    }
  }
}
