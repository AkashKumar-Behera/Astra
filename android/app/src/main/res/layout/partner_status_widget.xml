<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_status_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Header: Avatar + Name + Live Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Avatar Container -->
        <RelativeLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_avatar_bg">

            <ImageView
                android:id="@+id/widget_status_avatar_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Profile Picture"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/widget_status_avatar_initial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="A"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Name & Status -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_status_friend_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Partner"
                android:textColor="#F3F0FF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_status_last_seen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Astra Live"
                android:textColor="#9B95C9"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Live Pulse Dot -->
        <ImageView
            android:id="@+id/widget_status_live_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/widget_live_dot"
            android:contentDescription="Live indicator" />
    </LinearLayout>

    <!-- Center: Distance Display -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/widget_status_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="-- km away"
            android:textColor="#C084FC"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Telemetry Badges: Battery & Network -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Battery Badge -->
        <TextView
            android:id="@+id/widget_status_battery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_battery_bg"
            android:drawablePadding="4dp"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:text="🔋 --%"
            android:textColor="#A78BFA"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Network Badge -->
        <TextView
            android:id="@+id/widget_status_network"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_battery_bg"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:text="📶 Wi-Fi"
            android:textColor="#818CF8"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
